{% extends "layout.twig" %}

{% block content %}
<div class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-6">Referral Program</h1>

    <div class="bg-blue-600 rounded-lg shadow-lg p-8 text-white mb-8">
        <h2 class="text-xl font-semibold mb-2">Your Referral Code</h2>
        <div class="flex items-center gap-4">
            <code class="bg-blue-800 px-4 py-2 rounded text-2xl font-bold tracking-widest">{{ user.referral_code }}</code>
            <button class="bg-white text-blue-600 px-4 py-2 rounded font-bold hover:bg-gray-100" onclick="navigator.clipboard.writeText('{{ user.referral_code }}')">Copy Code</button>
        </div>
        <p class="mt-4 text-blue-100">Share this code with your friends and earn commissions on their investments!</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
        <div class="bg-white p-6 rounded-lg shadow">
            <h3 class="text-gray-500 text-sm font-medium uppercase">Total Referrals</h3>
            <p class="text-3xl font-bold text-gray-900">{{ referral_count }}</p>
        </div>
        <div class="bg-white p-6 rounded-lg shadow">
            <h3 class="text-gray-500 text-sm font-medium uppercase">Total Commissions</h3>
            <p class="text-3xl font-bold text-gray-900">$0.00</p>
        </div>
    </div>

    <h2 class="text-2xl font-bold mb-4">Referred Users</h2>
    <div class="bg-white rounded-lg shadow overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Username</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Joined At</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                {% for ref in referrals %}
                <tr>
                    <td class="px-6 py-4 whitespace-nowrap">{{ ref.username }}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{{ ref.joined_at }}</td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="2" class="px-6 py-4 text-center text-gray-500">You haven't referred anyone yet.</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
