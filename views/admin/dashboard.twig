{% extends "admin/layout.twig" %}

{% block content %}
<div class="p-6">
    <h1 class="text-3xl font-bold mb-8">Admin Dashboard</h1>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
        <div class="bg-white p-6 rounded-lg shadow border-l-4 border-blue-500">
            <h3 class="text-gray-500 text-xs font-bold uppercase tracking-wider">Total Users</h3>
            <p class="text-2xl font-bold">0</p>
        </div>
        <div class="bg-white p-6 rounded-lg shadow border-l-4 border-green-500">
            <h3 class="text-gray-500 text-xs font-bold uppercase tracking-wider">Total Deposits</h3>
            <p class="text-2xl font-bold">$0.00</p>
        </div>
        <div class="bg-white p-6 rounded-lg shadow border-l-4 border-red-500">
            <h3 class="text-gray-500 text-xs font-bold uppercase tracking-wider">Total Withdrawals</h3>
            <p class="text-2xl font-bold">$0.00</p>
        </div>
        <div class="bg-white p-6 rounded-lg shadow border-l-4 border-yellow-500">
            <h3 class="text-gray-500 text-xs font-bold uppercase tracking-wider">Pending Tasks</h3>
            <p class="text-2xl font-bold">0</p>
        </div>
    </div>
</div>
{% endblock %}
