{% extends "layout.twig" %}

{% block content %}
<div class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-6">Wallet</h1>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
        <div class="bg-white p-6 rounded-lg shadow">
            <h2 class="text-gray-500 text-sm font-medium uppercase tracking-wider">Available Balance</h2>
            <p class="text-3xl font-bold text-blue-600">${{ balance.available_balance|number_format(2) }}</p>
            <div class="mt-4 flex gap-2">
                <a href="/wallet/deposit" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">Deposit</a>
                <a href="/wallet/withdraw" class="bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700">Withdraw</a>
            </div>
        </div>
        <div class="bg-white p-6 rounded-lg shadow">
            <h2 class="text-gray-500 text-sm font-medium uppercase tracking-wider">Pending Balance</h2>
            <p class="text-3xl font-bold text-yellow-600">${{ balance.pending_balance|number_format(2) }}</p>
        </div>
    </div>

    <div class="bg-white rounded-lg shadow overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-semibold">Transaction History</h2>
        </div>
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                {% for tx in transactions %}
                <tr>
                    <td class="px-6 py-4 whitespace-nowrap">{{ tx.type|capitalize }}</td>
                    <td class="px-6 py-4 whitespace-nowrap {% if tx.amount < 0 %}text-red-600{% else %}text-green-600{% endif %}">
                        ${{ tx.amount|abs|number_format(2) }}
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full
                            {% if tx.status == 'completed' %}bg-green-100 text-green-800
                            {% elseif tx.status == 'pending' %}bg-yellow-100 text-yellow-800
                            {% else %}bg-red-100 text-red-800{% endif %}">
                            {{ tx.status|capitalize }}
                        </span>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{{ tx.created_at }}</td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="4" class="px-6 py-4 text-center text-gray-500">No transactions found.</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
