{% extends "layout.twig" %}

{% block content %}
<div class="max-w-2xl mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-6">Profile Settings</h1>

    {% if error %}
    <div class="bg-red-50 border-l-4 border-red-500 text-red-700 p-4 mb-6 rounded">
        <p class="text-sm font-medium">{{ error }}</p>
    </div>
    {% endif %}

    {% if session.updated %}
    <div class="bg-green-50 border-l-4 border-green-500 text-green-700 p-4 mb-6 rounded">
        <p class="text-sm font-medium">Profile updated successfully!</p>
    </div>
    {% endif %}

    <div class="bg-white p-6 rounded-lg shadow">
        <form action="/profile/update" method="POST">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700">Full Name</label>
                <input type="text" name="full_name" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2" value="{{ user.full_name }}">
            </div>

            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700">Email Address</label>
                <input type="email" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2 bg-gray-50" value="{{ user.email }}" disabled>
                <p class="text-xs text-gray-500 mt-1">Email cannot be changed.</p>
            </div>

            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700">Phone Number</label>
                <input type="text" name="phone_number" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2" value="{{ user.phone_number }}" placeholder="+254...">
            </div>

            <button type="submit" class="w-full bg-blue-600 text-white p-2 rounded-md hover:bg-blue-700">Update Profile</button>
        </form>
    </div>
</div>
{% endblock %}
