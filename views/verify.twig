{% extends "layout.twig" %}

{% block content %}
<div class="min-h-[70vh] flex items-center justify-center px-4 py-12">
    <div class="max-w-md w-full bg-white p-8 rounded-2xl shadow-xl text-center">
        <div class="w-20 h-20 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center text-4xl mx-auto mb-6">
            <i class="ri-mail-check-line"></i>
        </div>
        <h1 class="text-3xl font-bold mb-4 text-gray-900">Verify Email</h1>
        <p class="text-gray-500 mb-8">We've sent a 6-digit verification code to <span class="font-bold text-gray-700">{{ session.verify_email }}</span>. Please enter it below.</p>

        {% if error %}
        <div class="bg-red-50 border-l-4 border-red-500 text-red-700 p-4 mb-6 rounded text-left">
            <p class="text-sm font-medium">{{ error }}</p>
        </div>
        {% endif %}

        <form action="/verify" method="POST" class="space-y-6">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

            <div class="flex justify-center gap-2">
                <input type="text" name="code" class="block w-full text-center tracking-[1em] text-2xl font-bold py-4 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none transition" maxlength="6" placeholder="000000" required>
            </div>

            <button type="submit" class="w-full bg-blue-600 text-white py-4 rounded-xl font-bold text-lg hover:bg-blue-700 shadow-lg shadow-blue-200 transition transform hover:-translate-y-0.5">Verify & Activate</button>
        </form>

        <p class="mt-8 text-sm text-gray-400">
            Didn't receive the code? <a href="#" class="text-blue-600 font-bold hover:underline">Resend code</a>
        </p>
    </div>
</div>
{% endblock %}
