{% extends "layout.twig" %}

{% block content %}
<!-- Hero Section -->
<section class="bg-blue-600 text-white py-20">
    <div class="container mx-auto px-4 text-center">
        <h1 class="text-4xl md:text-6xl font-bold mb-6">Start Your Crypto Mining Journey</h1>
        <p class="text-xl text-blue-100 mb-10 max-w-2xl mx-auto">Join thousands of investors earning daily passive income through our high-performance mining clusters.</p>
        <div class="flex flex-col md:flex-row justify-center gap-4">
            <a href="/register" class="bg-white text-blue-600 px-8 py-4 rounded-xl font-bold text-lg hover:bg-gray-100 transition">Create Free Account</a>
            <a href="/login" class="bg-blue-700 text-white px-8 py-4 rounded-xl font-bold text-lg hover:bg-blue-800 transition border border-blue-500">Login to Dashboard</a>
        </div>
    </div>
</section>

<!-- Features -->
<section class="py-20">
    <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
            <div class="text-center">
                <div class="w-16 h-16 bg-blue-100 text-blue-600 rounded-2xl flex items-center justify-center text-3xl mx-auto mb-6">
                    <i class="ri-shield-check-line"></i>
                </div>
                <h3 class="text-xl font-bold mb-4">Secure & Reliable</h3>
                <p class="text-gray-500">Your investments are protected by industry-leading security protocols and cold storage solutions.</p>
            </div>
            <div class="text-center">
                <div class="w-16 h-16 bg-green-100 text-green-600 rounded-2xl flex items-center justify-center text-3xl mx-auto mb-6">
                    <i class="ri-money-dollar-circle-line"></i>
                </div>
                <h3 class="text-xl font-bold mb-4">Daily Payouts</h3>
                <p class="text-gray-500">Watch your balance grow every 24 hours with our automated mining distribution system.</p>
            </div>
            <div class="text-center">
                <div class="w-16 h-16 bg-purple-100 text-purple-600 rounded-2xl flex items-center justify-center text-3xl mx-auto mb-6">
                    <i class="ri-team-line"></i>
                </div>
                <h3 class="text-xl font-bold mb-4">Referral Program</h3>
                <p class="text-gray-500">Earn up to 10% commission on all investments made by people you refer to the platform.</p>
            </div>
        </div>
    </div>
</section>
{% endblock %}
